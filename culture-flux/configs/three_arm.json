    "rule_params": {
      "axelrod_homophily": {"events_per_agent_per_step": 1.0, "update_scheme": "batched", "drift_rate": 0.0001},
      "conformist": {"conformity": 3.0, "n_models": 5, "events_per_agent_per_step": 1.0, "drift_rate": 0.0001}
    },
    "influence_model": "uniform",
    "influence_params": {}
  },
  "runtime": {"total_years": 1500.0, "steps_per_year": 12, "years_per_generation": 25.0, "measure_every_steps": 180},
  "metrics": {"include": null, "include_placeholders": true},
  "output": {"directory": "results", "write_final_population": false, "write_timeseries": true, "format": "auto"}
