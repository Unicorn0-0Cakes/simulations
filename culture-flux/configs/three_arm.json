{
  "name": "three-arm",
  "description": "Base configuration for the comparison A-016 requires: the same city, the same arrivals, three mechanisms. drift_rate is set to 1e-4, in the transmission-dominated regime -- above ~1e-3 the homophily arm becomes indistinguishable from drift alone and measures the noise floor (pilot P-8). Every parameter is a placeholder.",
  "seed": 1,
  "schema_version": 3,
  "population": {"initial_size": 500, "within_source_noise": 0.0},
  "culture": {"features": 10, "traits_per_feature": 5, "distance_metric": "hamming"},
  "migration": {
