{
  "name": "homophily-v0",
  "description": "Reference configuration for the first active transmission rule. The rule is an Axelrod-FAMILY rule specified in dynamics/homophily.py -- NOT a verified reproduction of Axelrod (1997), which has not been read. See assumption A-016. Every parameter is a placeholder; nothing here is calibrated.",
  "seed": 1,
  "schema_version": 2,
  "population": {
    "initial_size": 2000,
    "within_source_noise": 0.0
  },
  "culture": {
    "features": 20,
    "traits_per_feature": 5,
    "distance_metric": "hamming"
  },
  "migration": {
    "mode": "addition",
    "total_share": 0.3,
    "source_count": 1,
    "source_distribution": "single",
    "cultural_distance": "medium",
    "arrangement": "independent",
    "start_year": 0.0,
    "duration_years": 20.0,
    "arrival_profile": "uniform"
  },
  "network": {
    "layers": [
      "citywide"
    ]
  },
  "dynamics": {
    "transmission_rule": "axelrod_homophily",
    "rule_params": {
      "axelrod_homophily": {
        "events_per_agent_per_step": 1.0,
        "update_scheme": "batched"
      }
    },
    "influence_model": "uniform"
  },
  "runtime": {
    "total_years": 100.0,
    "steps_per_year": 12,
    "years_per_generation": 25.0,
    "measure_every_steps": 12
  },
  "metrics": {
    "include": null,
    "include_placeholders": true
  },
  "output": {
    "directory": "results",
    "write_final_population": false,
    "write_timeseries": true,
    "format": "auto"
  }
}
