{
  "name": "structured-v0",
  "description": "First configuration with a structured city. Household, neighbourhood, workplace and attention layers alongside the weak citywide tail. Every layer weight and size is a placeholder (A-019); none is drawn from data. Compare against configs/homophily_v0.json, which is the same model in a single well-mixed pool.",
  "seed": 1,
  "schema_version": 3,
  "population": {"initial_size": 2000, "within_source_noise": 0.0},
  "culture": {"features": 20, "traits_per_feature": 5, "distance_metric": "hamming"},
  "migration": {
    "mode": "addition",
    "total_share": 0.30,
    "source_count": 1,
    "source_distribution": "single",
    "cultural_distance": "medium",
    "arrangement": "independent",
    "start_year": 0.0,
    "duration_years": 20.0,
    "arrival_profile": "uniform"
  },
  "network": {
    "layers": {
      "household": {"weight": 0.30, "target_size": 3},
      "neighbourhood": {"weight": 0.20, "target_size": 150},
      "workplace": {"weight": 0.30, "target_size": 25},
      "friendship": {"weight": 0.15, "degree": 8, "rewire_rate": 0.0, "rewire_candidates": 4},
      "citywide": {"weight": 0.05}
    },
    "assignment": "random",
    "clustering": 0.0,
    "rewire_every_steps": 12
  },
  "dynamics": {
    "transmission_rule": "axelrod_homophily",
    "rule_params": {"axelrod_homophily": {"events_per_agent_per_step": 1.0, "update_scheme": "batched"}},
    "influence_model": "uniform",
    "influence_params": {}
  },
  "runtime": {"total_years": 200.0, "steps_per_year": 12, "years_per_generation": 25.0, "measure_every_steps": 24},
  "metrics": {"include": null, "include_placeholders": true},
  "output": {"directory": "results", "write_final_population": false, "write_timeseries": true, "format": "auto"}
}
