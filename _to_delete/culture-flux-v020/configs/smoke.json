{
  "name": "smoke",
  "description": "Trivial run proving the architecture executes end to end. Not a scientific result: the transmission rule is the explicit null, so nothing here is a claim about cultural change.",
  "seed": 1,
  "schema_version": 2,
  "population": {
    "initial_size": 1000,
    "within_source_noise": 0.0
  },
  "culture": {
    "features": 10,
    "traits_per_feature": 5,
    "distance_metric": "hamming"
  },
  "migration": {
    "mode": "addition",
    "total_share": 0.3,
    "source_count": 2,
    "source_distribution": "even",
    "cultural_distance": "medium",
    "arrangement": "independent",
    "start_year": 0.0,
    "duration_years": 10.0,
    "arrival_profile": "uniform"
  },
  "network": {
    "layers": [
      "citywide"
    ]
  },
  "dynamics": {
    "transmission_rule": "null",
    "influence_model": "uniform"
  },
  "runtime": {
    "total_years": 20.0,
    "steps_per_year": 12,
    "years_per_generation": 25.0,
    "measure_every_steps": 12
  },
  "metrics": {
    "include": null,
    "include_placeholders": true
  },
  "output": {
    "directory": "results",
    "write_final_population": true,
    "write_timeseries": true,
    "format": "auto"
  }
}
